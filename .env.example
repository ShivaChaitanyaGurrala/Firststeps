TMDB_API_TOKEN=your_v4_bearer_token_here
# Local Postgres — see infra/postgres_setup.sql for the one-time role/db
# creation this expects, or run the postgres:16 container with matching
# POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB env vars.
DATABASE_URL=postgresql+psycopg2://tmdb_app:tmdb_local_dev_pw@localhost:5432/tmdb_local
LOG_LEVEL=INFO
