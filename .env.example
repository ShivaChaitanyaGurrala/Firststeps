TMDB_API_TOKEN=your_v4_bearer_token_here
# Local Postgres — see infra/postgres_setup.sql for the one-time role/db
# creation this expects, or run the postgres:16 container with matching
# POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB env vars.
DATABASE_URL=postgresql+psycopg2://tmdb_app:tmdb_local_dev_pw@localhost:5432/tmdb_local
LOG_LEVEL=INFO

# M4 rag_service (a separate service from data_service — see
# rag_service/config.py). VOYAGE_API_KEY: either https://dash.voyageai.com/
# directly, or a "model API key" from MongoDB Atlas (Voyage AI's parent
# company) — the latter authenticates against ai.mongodb.com instead of
# api.voyageai.com, hence VOYAGE_BASE_URL below. Same models/service either
# way. COHERE_API_KEY: https://dashboard.cohere.com/api-keys
# Chroma runs client-server via Docker, not embedded — see
# rag_service/config.py's chroma_host/chroma_port docstring for the
# `docker run` command.
VOYAGE_API_KEY=your_voyage_api_key_here
VOYAGE_BASE_URL=https://api.voyageai.com/v1
COHERE_API_KEY=your_cohere_api_key_here
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=movie_reviews

# evals/rag/run_ragas_eval.py only (standalone script, not read by
# data_service/rag_service Settings) — OpenAI plays both the eval's answer
# generator and RAGAS's internal judge role. gpt-4o-mini chosen for cost/
# speed given the eval's small scale, not for maximum judge quality.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
